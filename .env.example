# Discord
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Turso (libSQL) database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Comma-separated list of Discord user IDs allowed to reset the counter
AUTHORIZED_USER_IDS=123456789012345678,987654321098765432

# Secret used to protect the Vercel Cron endpoint
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# Public base URL of the deployed app (used by the cron job to build the OG image URL)
APP_URL=http://localhost:3000

# Optional: ISO timestamp to backdate the initial incident when seeding (e.g. 2026-07-01T00:00:00Z)
# SEED_LAST_INCIDENT_AT=
